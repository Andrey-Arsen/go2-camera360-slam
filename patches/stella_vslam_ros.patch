+
+    // camera360_slam: как часто публиковать точки карты, с (0 — не публиковать)
+    landmarks_period_ = node_->declare_parameter("landmarks_period", 1.0);
+}
+
+void system::publish_landmarks(const rclcpp::Time& stamp) {
+    const double t = stamp.seconds();
+    if (landmarks_period_ <= 0.0 || (last_landmarks_t_ >= 0.0 && t >= last_landmarks_t_ && t - last_landmarks_t_ < landmarks_period_)) {
+        return;
+    }
+    last_landmarks_t_ = t;
+    std::vector<std::shared_ptr<stella_vslam::data::landmark>> all_lms;
+    std::set<std::shared_ptr<stella_vslam::data::landmark>> local_lms;
+    slam_->get_map_publisher()->get_landmarks(all_lms, local_lms);
+    sensor_msgs::msg::PointCloud2 msg;
+    msg.header.stamp = stamp;
+    msg.header.frame_id = map_frame_;
+    sensor_msgs::PointCloud2Modifier modifier(msg);
+    // kx, ky, kz — центр камеры опорного ключевого кадра точки: оттуда её точно было видно
+    // (луч камера -> точка свободен — по нему строится карта препятствий)
+    modifier.setPointCloud2Fields(7, "x", 1, sensor_msgs::msg::PointField::FLOAT32,
+                                  "y", 1, sensor_msgs::msg::PointField::FLOAT32,
+                                  "z", 1, sensor_msgs::msg::PointField::FLOAT32,
+                                  "observations", 1, sensor_msgs::msg::PointField::FLOAT32,
+                                  "kx", 1, sensor_msgs::msg::PointField::FLOAT32,
+                                  "ky", 1, sensor_msgs::msg::PointField::FLOAT32,
+                                  "kz", 1, sensor_msgs::msg::PointField::FLOAT32);
+    modifier.resize(all_lms.size());
+    sensor_msgs::PointCloud2Iterator<float> it_x(msg, "x"), it_y(msg, "y"), it_z(msg, "z"), it_o(msg, "observations");
+    sensor_msgs::PointCloud2Iterator<float> it_kx(msg, "kx"), it_ky(msg, "ky"), it_kz(msg, "kz");
+    size_t n = 0;
+    for (const auto& lm : all_lms) {
+        if (!lm || lm->will_be_erased()) {
+            continue;
+        }
+        const Eigen::Vector3d p = rot_ros_to_cv_map_frame_ * lm->get_pos_in_world();
+        const auto ref_keyfrm = lm->get_ref_keyframe();
+        const Eigen::Vector3d k = ref_keyfrm ? Eigen::Vector3d(rot_ros_to_cv_map_frame_ * ref_keyfrm->get_trans_wc()) : p;
+        *it_x = static_cast<float>(p.x());
+        *it_y = static_cast<float>(p.y());
+        *it_z = static_cast<float>(p.z());
+        *it_o = static_cast<float>(lm->num_observations());
+        *it_kx = static_cast<float>(k.x());
+        *it_ky = static_cast<float>(k.y());
+        *it_kz = static_cast<float>(k.z());
+        ++it_x, ++it_y, ++it_z, ++it_o, ++it_kx, ++it_ky, ++it_kz, ++n;
+    }
+    modifier.resize(n);
+    landmarks_pub_->publish(msg);
 }
 
